# Cloudflare Worker deployment inputs.
#
# There is no ".env" for the deployed Worker: it has no environment variables or
# secrets. Its entire configuration is two bindings declared in
# controller/wrangler.template.jsonc — DB (D1) and ASSETS (static assets) — and all
# runtime secrets (LG_TOKEN_SIGN_JWK, TURNSTILE_SECRET_KEY,
# CLOUDFLARE_DNSUPDATE_API_KEY, ACME settings, ...) live in D1 and are managed
# from the /admin panel after deploy.
#
# This file documents the environment the DEPLOY step needs. It is consumed by
# controller/scripts/write-wrangler-config.mjs (which renders wrangler.jsonc) and by
# controller/scripts/deploy.mjs, both of which load .env.cloudflare automatically.
# CI/init use the same script, so put the values there too (or export them).
#
# Copy to `.env.cloudflare` (git-ignored) and fill in. Existing environment
# variables always win, so CI secrets/vars are never overridden by this file.

# ── Wrangler config generation (controller/scripts/write-wrangler-config.mjs) ─────
# These render controller/wrangler.template.jsonc into controller/wrangler.jsonc.
WORKER_NAME=my-looking-glass
D1_NAME=looking-glass
# From `pnpm -C controller exec wrangler d1 create <D1_NAME>` at the repo root.
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# Cron schedule(s) for the background pass. Comma-separate multiple entries.
# Optional: defaults to every 30 minutes. Set to "none" to disable the
# scheduled pass entirely — note this also stops ACME renewal, certificate
# nudges, retention cleanup and the availability sweep, so only do it if you
# renew certificates another way.
# Example (default):
WORKER_CRONS=*/30 * * * *
# Example (two schedules; quote if the value contains "#"):
# WORKER_CRONS="*/10 * * * *, 0 * * * *"

# ── Wrangler deploy ───────────────────────────────────────────────────────────
# Or run `pnpm -C controller exec wrangler login` instead of using an API token.
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=your-api-token-with-workers-and-d1-edit

# ── GitHub Actions equivalent ─────────────────────────────────────────────────
# If you deploy via .github/workflows/deploy-worker.yml instead, set these in
# the "cloudflare-env" environment:
#   Variables: WORKER_CRONS
#   Secrets:   WORKER_NAME, D1_NAME, D1_DATABASE_ID, CLOUDFLARE_ACCOUNT_ID,
#              CLOUDFLARE_API_TOKEN
