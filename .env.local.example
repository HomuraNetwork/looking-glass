# Local Node / self-hosted Compose configuration.
#
# This file documents the LG_* environment the Node runtime (controller/local)
# reads. Copy to `.env.local` (git-ignored). `pnpm dev:local` reads it, or use:
#   node --env-file=.env.local controller/local/dist/server.cjs
#   docker compose --env-file .env.local up --build
#
# Every value below is optional. Compose keeps its database inside a named
# volume; LG_DB_PATH below applies to the direct Node runtime only.

# ── Listener / storage ────────────────────────────────────────────────────────
LG_PORT=8787
# SQLite file. Docker image default: /var/lib/hlg/looking-glass.sqlite
# LG_DB_PATH=./looking-glass.sqlite
# Built frontend assets. Default resolves next to the bundle
# (controller/frontend/dist), so you usually do not need to set this.
# LG_ASSETS_DIR=./controller/frontend/dist
# Background pass schedule (5-field cron, same syntax as the Cloudflare
# crons trigger). Retention / ACME renewal / certificate nudge / availability.
# Defaults to every 30 minutes; "none" disables the background pass.
# LG_SCHEDULE_CRON="*/30 * * * *"

# ── Public origin / reverse proxy ─────────────────────────────────────────────
# Canonical external origin. Strongly recommended in any real deployment: the
# runtime uses it for request URLs, the admin session cookie's Secure attribute,
# and signed config. e.g. https://lg.example.com
# LG_PUBLIC_ORIGIN=https://lg.example.com
#
# Set to 1 ONLY when behind a reverse proxy you control. The client IP is then
# taken from the forwarded header (rightmost non-proxy entry) and the scheme
# from x-forwarded-proto. Without it, client IPs always come from the TCP peer
# and client-supplied forwarding headers are ignored.
#
# The proxy MUST OVERWRITE (not append to) any client-supplied forwarded header,
# or a direct attacker can still forge it. See controller/local/request.ts.
# LG_TRUST_PROXY=1
#
# How many proxy hops to trust when reading the forwarded chain (default 1).
# LG_TRUST_PROXY_HOPS=1
#
# Header the trusted proxy sets the client IP in (default x-forwarded-for).
# Use this when the front proxy emits a different one — e.g. x-real-ip, or
# cf-connecting-ip when Cloudflare fronts your origin (set LG_TRUST_PROXY_HOPS
# to match the Cloudflare edge). Only read when LG_TRUST_PROXY=1.
# LG_TRUST_PROXY_HEADER=x-forwarded-for
# (LG_CLIENT_IP_HEADER is a deprecated alias and still works; a warning is logged.)
#
# Optional allowlist of trusted proxy source addresses (comma/space separated
# IPs or CIDRs; IPv4 and IPv6). It is applied ONLY while LG_TRUST_PROXY_HEADER is
# not set: with the default header, a request from a peer outside the list is
# treated as an ordinary client (its own address is used, forwarding headers are
# ignored) and the runtime warns. Setting LG_TRUST_PROXY_HEADER explicitly (e.g.
# behind CloudFront/Cloudflare, whose origin address set is too large to
# enumerate) opts OUT of the allowlist — the runtime then logs a reminder that
# you must restrict the origin port with a firewall/network policy yourself.
# LG_TRUSTED_PROXY_CIDRS="127.0.0.1/32, ::1/128, 172.18.0.0/16"

# ── First run ─────────────────────────────────────────────────────────────────
# No seeding is required. On first start the schema is created automatically;
# open the origin at /admin to create the first administrator and a node.
#
# Runtime secrets (LG_TOKEN_SIGN_JWK, TURNSTILE_SECRET_KEY,
# CLOUDFLARE_DNSUPDATE_API_KEY, ACME settings, ...) are NOT environment
# variables: they live in the database and are managed from the admin panel.
