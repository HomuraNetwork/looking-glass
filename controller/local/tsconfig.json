{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true
  },
  "include": ["**/*.ts", "../src/**/*.ts", "../shared/**/*.mjs"],
  "exclude": ["../src/index.ts", "../src/runtime/cloudflare.ts"]
}
